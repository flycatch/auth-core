{
  "compilerOptions": {
    "target": "ES2018",
    "module": "CommonJS",
    "declaration": true,    // Generates .d.ts files
    "outDir": "dist",       // Output directory
    "rootDir": "src",       // Source directory
    "strict": true,         // Enforces type safety
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}